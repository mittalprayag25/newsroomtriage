# auto: heuristic until TRIAGE_BASE_URL or TRIAGE_API_KEY is set, then the model.
# heuristic: always the local rules.
# llm: always the OpenAI-compatible endpoint.
TRIAGE_MODE=auto

# Leave both empty to run fully offline.
TRIAGE_BASE_URL=
TRIAGE_API_KEY=
TRIAGE_MODEL=gpt-4o-mini

# Ollama running on the Mac, from inside this container:
# TRIAGE_BASE_URL=http://host.docker.internal:11434/v1
# TRIAGE_MODEL=llama3.2
# TRIAGE_API_KEY=ollama

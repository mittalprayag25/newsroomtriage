# llm: every email is classified by the model. A failed call is shown, not replaced by the phrase rules.
# heuristic: the local phrase rules only. Set this explicitly to turn the model off.
# auto: the model when TRIAGE_BASE_URL or TRIAGE_API_KEY is set, otherwise the phrase rules.
TRIAGE_MODE=llm

# AI Singapore SEA-LION. The chat endpoint is OpenAI-compatible.
# Create a trial key at the SEA-LION console. Do not commit it.
TRIAGE_BASE_URL=https://api.sea-lion.ai/v1
TRIAGE_API_KEY=
TRIAGE_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT
TRIAGE_TIMEOUT_SECONDS=90

# Google Cloud OAuth client. In Google Auth Platform > Clients, create a Web
# application client, add the redirect URI below, and select
# "Use this client for an AI-powered agent". Do not commit the secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
GOOGLE_TOKEN_PATH=data/google-token.json
NEWSROOM_DB=data/newsroom.sqlite
HOUSE_STYLE_PATH=house-style.md
GMAIL_QUERY=in:inbox newer_than:2d
JOB_INTERVAL_SECONDS=1800
